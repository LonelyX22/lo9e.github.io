<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#050b16">
<title>MARINE CONTROL SYSTEM</title>

<style>
:root {
  --bg:#050b16;
  --panel:#0b1728;
  --panel2:#101f33;
  --line:#1b3550;
  --cyan:#29d9ff;
  --blue:#3989ff;
  --green:#42f5a1;
  --red:#ff405c;
  --muted:#718aa6;
  --white:#eaf7ff;
}

* {
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
  user-select:none;
}

html,body {
  margin:0;
  min-height:100%;
  background:var(--bg);
  color:var(--white);
  font-family:Arial,Helvetica,sans-serif;
  overflow-x:hidden;
}

body {
  background:
    radial-gradient(ellipse at 50% -20%,#15385b 0%,transparent 55%),
    radial-gradient(ellipse at 100% 100%,#10284a 0%,transparent 40%),
    var(--bg);
}

button {
  font:inherit;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}

button:active {
  transform:scale(.97);
}

.hidden { display:none!important; }

/* =================================
   BACKGROUND EFFECTS
================================= */

.background-grid {
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  opacity:.18;
  background-image:
    linear-gradient(#2b86b5 1px,transparent 1px),
    linear-gradient(90deg,#2b86b5 1px,transparent 1px);
  background-size:42px 42px;
  mask-image:linear-gradient(to bottom,black,transparent 90%);
}

.ambient {
  position:fixed;
  width:300px;
  height:300px;
  border-radius:50%;
  filter:blur(100px);
  opacity:.13;
  pointer-events:none;
  z-index:0;
  background:var(--cyan);
  top:20%;
  left:-180px;
}

/* =================================
   LOADING
================================= */

#loader {
  position:fixed;
  inset:0;
  z-index:99999;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  background:#030914;
  transition:opacity .6s,visibility .6s;
}

#loader.hide {
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.load-logo {
  font-size:29px;
  font-weight:900;
  letter-spacing:5px;
  color:var(--cyan);
  text-shadow:0 0 25px #29d9ff99;
}

.load-sub {
  font-size:9px;
  color:var(--muted);
  letter-spacing:5px;
  margin-top:10px;
}

.load-circle {
  width:130px;
  height:130px;
  margin:35px 0 22px;
  border-radius:50%;
  display:grid;
  place-items:center;
  position:relative;
  background:conic-gradient(var(--cyan) 0%,#15253a 0%);
  box-shadow:0 0 35px #29d9ff20;
}

.load-circle::before {
  content:"";
  position:absolute;
  inset:7px;
  border-radius:50%;
  background:#07111f;
}

.load-percent {
  position:relative;
  z-index:2;
  font-size:30px;
  font-weight:900;
}

.load-bar {
  width:min(280px,75vw);
  height:4px;
  background:#15283d;
  border-radius:10px;
  overflow:hidden;
}

.load-fill {
  height:100%;
  width:0;
  background:var(--cyan);
  box-shadow:0 0 15px var(--cyan);
}

.load-message {
  margin-top:15px;
  font-size:9px;
  color:var(--muted);
  letter-spacing:3px;
}

/* =================================
   APP
================================= */

.app {
  position:relative;
  z-index:1;
  max-width:1200px;
  padding:18px;
  margin:auto;
}

/* =================================
   HEADER
================================= */

.header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  padding-bottom:17px;
  border-bottom:1px solid #24415b;
}

.brand {
  display:flex;
  align-items:center;
  gap:12px;
}

.brand-icon {
  width:46px;
  height:46px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(145deg,#123b5b,#0b1d31);
  border:1px solid #286b8a;
  color:var(--cyan);
  font-size:23px;
  box-shadow:0 0 20px #29d9ff19;
}

.brand-name {
  font-size:20px;
  font-weight:900;
  letter-spacing:2px;
}

.brand-name span {
  color:var(--cyan);
}

.brand-caption {
  font-size:9px;
  color:var(--muted);
  letter-spacing:3px;
  margin-top:5px;
}

.header-actions {
  display:flex;
  align-items:center;
  gap:8px;
}

.icon-button {
  background:#10243a;
  border:1px solid #24415b;
  border-radius:11px;
  padding:11px 14px;
  color:var(--cyan);
  font-weight:bold;
}

/* =================================
   CONNECTION BAR
================================= */

.connection-bar {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:16px 0;
  padding:12px 15px;
  background:#0c1a2b;
  border:1px solid #203b55;
  border-radius:12px;
}

.connection-left {
  display:flex;
  align-items:center;
  gap:10px;
  font-size:10px;
  letter-spacing:2px;
}

.connection-dot {
  width:9px;
  height:9px;
  border-radius:50%;
  background:var(--green);
  box-shadow:0 0 12px var(--green);
}

.connection-dot.offline {
  background:var(--red);
  box-shadow:0 0 12px var(--red);
}

.connection-label {
  color:var(--green);
  font-weight:bold;
}

.connection-label.offline {
  color:var(--red);
}

.connection-right {
  color:var(--muted);
  font-size:9px;
  letter-spacing:1px;
}

/* =================================
   DASHBOARD GRID
================================= */

.dashboard {
  display:grid;
  grid-template-columns:1fr 1.55fr 1fr;
  gap:13px;
  align-items:stretch;
}

.panel {
  position:relative;
  overflow:hidden;
  background:linear-gradient(145deg,#102137,#091524);
  border:1px solid #23415c;
  border-radius:17px;
  padding:16px;
  box-shadow:0 12px 30px #0005;
}

.panel::after {
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--cyan),transparent);
  opacity:.55;
}

.panel-heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:10px;
  letter-spacing:2px;
  color:#b5d4e9;
  font-weight:bold;
  margin-bottom:15px;
}

.panel-number {
  color:var(--cyan);
  font-size:9px;
}

/* =================================
   RADAR
================================= */

.radar-wrap {
  display:flex;
  justify-content:center;
  align-items:center;
  padding:8px 0 15px;
}

.radar {
  width:min(100%,190px);
  aspect-ratio:1;
  position:relative;
  border-radius:50%;
  overflow:hidden;
  border:1px solid #257393;
  background:
    radial-gradient(circle,transparent 18%,#1a789020 19%,transparent 20%),
    radial-gradient(circle,transparent 39%,#1a789020 40%,transparent 41%),
    radial-gradient(circle,transparent 59%,#1a789020 60%,transparent 61%),
    radial-gradient(circle,#0b2435,#07111d);
  box-shadow:0 0 25px #29d9ff16,inset 0 0 30px #29d9ff0c;
}

.radar::before {
  content:"";
  position:absolute;
  inset:50% 0 auto;
  height:1px;
  background:#29d9ff44;
}

.radar::after {
  content:"";
  position:absolute;
  left:50%;
  top:0;
  width:1px;
  height:100%;
  background:#29d9ff44;
}

.radar-sweep {
  position:absolute;
  inset:0;
  border-radius:50%;
  background:conic-gradient(from 0deg,transparent 0deg,transparent 270deg,#29d9ff05 300deg,#29d9ff60 360deg);
  animation:radarSpin 4s linear infinite;
}

@keyframes radarSpin {
  to { transform:rotate(360deg); }
}

.radar-center {
  position:absolute;
  width:10px;
  height:10px;
  background:var(--cyan);
  border-radius:50%;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  box-shadow:0 0 15px var(--cyan);
  z-index:2;
}

.radar-ring {
  position:absolute;
  inset:15%;
  border:1px solid #29d9ff22;
  border-radius:50%;
}

.radar-label {
  position:absolute;
  font-size:8px;
  color:#679bb6;
}

.radar-n {top:6px;left:50%;transform:translateX(-50%)}
.radar-s {bottom:6px;left:50%;transform:translateX(-50%)}
.radar-e {right:6px;top:50%;transform:translateY(-50%)}
.radar-w {left:6px;top:50%;transform:translateY(-50%)}

.radar-caption {
  text-align:center;
  font-size:9px;
  color:var(--muted);
  letter-spacing:2px;
}

.radar-caption span {
  color:var(--green);
}

/* =================================
   CENTER CONTROL
================================= */

.center-panel {
  min-width:0;
}

.center-title {
  text-align:center;
  margin:0 0 4px;
  font-size:13px;
  letter-spacing:3px;
  font-weight:900;
}

.center-sub {
  text-align:center;
  color:var(--muted);
  font-size:8px;
  letter-spacing:2px;
  margin-bottom:20px;
}

.joystick-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.joy-box {
  background:#071321;
  border:1px solid #1b3850;
  border-radius:14px;
  padding:12px 6px;
  text-align:center;
}

.joy-title {
  font-size:12px;
  font-weight:900;
  letter-spacing:2px;
  margin-bottom:5px;
}

.joy-purpose {
  font-size:8px;
  letter-spacing:2px;
  color:var(--muted);
  margin-bottom:12px;
}

.green {color:var(--green)}
.cyan {color:var(--cyan)}

.joystick {
  width:min(100%,205px);
  aspect-ratio:1;
  position:relative;
  margin:auto;
  border-radius:50%;
  border:3px solid #34516b;
  background:
    radial-gradient(circle,transparent 30%,#29d9ff12 31%,transparent 32%),
    linear-gradient(90deg,transparent 49.7%,#32536b 50%,transparent 50.3%),
    linear-gradient(transparent 49.7%,#32536b 50%,transparent 50.3%),
    radial-gradient(circle at 35% 30%,#193a55,#081525 75%);
  box-shadow:
    inset 0 0 25px #0009,
    0 0 15px #29d9ff10;
  touch-action:none;
  overflow:hidden;
}

.joystick.disabled {
  opacity:.4;
  pointer-events:none;
}

.joystick::before {
  content:"";
  position:absolute;
  inset:9%;
  border:1px solid #29d9ff24;
  border-radius:50%;
}

.joy-axis {
  position:absolute;
  font-size:8px;
  color:#91abc0;
  font-weight:bold;
  letter-spacing:1px;
}

.axis-top {top:7px;left:50%;transform:translateX(-50%)}
.axis-bottom {bottom:7px;left:50%;transform:translateX(-50%)}
.axis-left {left:7px;top:50%;transform:translateY(-50%)}
.axis-right {right:7px;top:50%;transform:translateY(-50%)}

.knob {
  width:34%;
  height:34%;
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%) translate(var(--x,0px),var(--y,0px));
  border-radius:50%;
  border:2px solid #d8f5ff;
  background:linear-gradient(145deg,#c5e7f6,#607d9c 65%,#233b54);
  box-shadow:
    0 5px 15px #000a,
    0 0 17px #29d9ff36,
    inset 0 3px 7px #ffffffa0;
  pointer-events:none;
}

.knob::after {
  content:"";
  position:absolute;
  inset:32%;
  border-radius:50%;
  background:#142a40;
  border:1px solid #83c9e8;
}

.joy-value {
  font-size:21px;
  font-weight:900;
  margin-top:12px;
}

.joy-direction {
  font-size:8px;
  color:var(--muted);
  letter-spacing:2px;
  margin-top:4px;
}

/* =================================
   MOTOR TELEMETRY
================================= */

.motor-section {
  margin-top:14px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.motor-card {
  background:#071321;
  border:1px solid #1b3850;
  padding:12px;
  border-radius:12px;
}

.motor-card-title {
  color:var(--muted);
  font-size:8px;
  letter-spacing:2px;
  margin-bottom:9px;
}

.motor-speed {
  font-size:19px;
  font-weight:900;
}

.motor-track {
  height:5px;
  border-radius:10px;
  background:#1a2c40;
  overflow:hidden;
  margin-top:10px;
}

.motor-fill {
  width:0;
  height:100%;
  border-radius:10px;
  background:linear-gradient(90deg,#1672a8,var(--cyan));
  transition:width .12s;
}

.motor-fill.right {
  background:linear-gradient(90deg,#168b62,var(--green));
}

/* =================================
   RIGHT DATA
================================= */

.data-card {
  background:#071321;
  border:1px solid #1b3850;
  padding:12px;
  border-radius:11px;
  margin-bottom:9px;
}

.data-label {
  color:var(--muted);
  font-size:8px;
  letter-spacing:2px;
}

.data-value {
  font-size:21px;
  font-weight:900;
  margin-top:7px;
}

.data-small {
  color:#5e849f;
  font-size:8px;
  margin-top:5px;
}

/* =================================
   BOTTOM ACTIONS
================================= */

.bottom-section {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
  margin-top:14px;
}

.action-panel {
  background:#0b192a;
  border:1px solid #203d56;
  border-radius:14px;
  padding:14px;
}

.action-heading {
  font-size:9px;
  letter-spacing:2px;
  color:var(--muted);
  margin-bottom:12px;
}

.action-row {
  display:flex;
  gap:9px;
}

.action-button {
  flex:1;
  border:1px solid #27506d;
  background:#10283d;
  color:var(--cyan);
  padding:14px 8px;
  border-radius:10px;
  font-size:10px;
  font-weight:900;
  letter-spacing:1px;
}

.action-button.active {
  color:#062116;
  background:var(--green);
  border-color:var(--green);
  box-shadow:0 0 20px #42f5a144;
}

.emergency {
  width:100%;
  margin-top:14px;
  border:1px solid #ff5269;
  background:linear-gradient(110deg,#a40d2c,#ed2847,#a40d2c);
  background-size:200% 100%;
  color:white;
  border-radius:13px;
  padding:17px;
  font-size:14px;
  font-weight:900;
  letter-spacing:3px;
  box-shadow:0 5px 25px #ff244526;
  animation:emergencyGlow 2s infinite alternate;
}

@keyframes emergencyGlow {
  from {box-shadow:0 0 8px #ff244522}
  to {box-shadow:0 0 22px #ff244566}
}

/* =================================
   FOOTER
================================= */

.footer {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:17px;
  padding-top:13px;
  border-top:1px solid #1d3348;
  font-size:8px;
  color:#58738d;
  letter-spacing:2px;
}

.footer span:last-child {
  color:var(--cyan);
}

/* =================================
   FULLSCREEN
================================= */

body.fullscreen-mode .app {
  max-width:none;
  padding:8px;
}

body.fullscreen-mode .header {
  padding-bottom:7px;
}

body.fullscreen-mode .connection-bar {
  margin:8px 0;
  padding:8px 12px;
}

body.fullscreen-mode .dashboard {
  grid-template-columns:.85fr 1.6fr .85fr;
  gap:9px;
}

body.fullscreen-mode .panel {
  padding:10px;
}

body.fullscreen-mode .radar {
  width:min(100%,145px);
}

body.fullscreen-mode .center-title {
  font-size:11px;
  margin-bottom:2px;
}

body.fullscreen-mode .center-sub {
  margin-bottom:8px;
}

body.fullscreen-mode .joy-box {
  padding:7px 4px;
}

body.fullscreen-mode .joy-purpose {
  margin-bottom:5px;
}

body.fullscreen-mode .joystick {
  width:min(100%,min(29vh,190px));
}

body.fullscreen-mode .joy-value {
  margin-top:5px;
  font-size:17px;
}

body.fullscreen-mode .motor-section {
  margin-top:8px;
  gap:5px;
}

body.fullscreen-mode .motor-card {
  padding:7px;
}

body.fullscreen-mode .bottom-section {
  margin-top:8px;
}

body.fullscreen-mode .instructions-hide {
  display:none!important;
}

@media(max-width:850px) {
  .dashboard {
    grid-template-columns:1fr 1fr;
  }

  .center-panel {
    grid-column:1/-1;
    grid-row:1;
  }

  .left-panel,.right-panel {
    grid-row:2;
  }

  .radar {
    width:min(100%,145px);
  }
}

@media(max-width:600px) and (orientation:portrait) {
  .app {padding:12px}

  .brand-name {font-size:16px}
  .brand-caption {font-size:7px;letter-spacing:2px}
  .brand-icon {width:38px;height:38px}

  .dashboard {
    grid-template-columns:1fr 1fr;
    gap:8px;
  }

  .center-panel {
    grid-column:1/-1;
    grid-row:1;
  }

  .left-panel,.right-panel {
    grid-row:auto;
  }

  .joystick-grid {gap:7px}
  .joy-box {padding:10px 5px}
  .joystick {width:100%;max-width:180px}
  .panel {padding:11px}
  .bottom-section {grid-template-columns:1fr}
}

@media(max-width:750px) and (orientation:landscape) {
  .app {padding:7px}

  .header {padding-bottom:7px}
  .brand-icon {width:33px;height:33px}
  .brand-name {font-size:15px}
  .brand-caption {font-size:7px}

  .connection-bar {
    margin:7px 0;
    padding:7px 10px;
  }

  .dashboard {
    grid-template-columns:.8fr 1.6fr .8fr;
    gap:7px;
  }

  .center-panel {
    grid-column:auto;
    grid-row:auto;
  }

  .left-panel,.right-panel {grid-row:auto}

  .panel {padding:8px}
  .panel-heading {margin-bottom:7px;font-size:8px}

  .radar {width:min(100%,115px)}

  .center-title {font-size:10px}
  .center-sub {margin-bottom:7px}

  .joy-box {padding:6px 3px}
  .joy-title {font-size:9px}
  .joy-purpose {font-size:7px;margin-bottom:5px}

  .joystick {width:min(100%,min(28vh,145px))}
  .joy-value {font-size:15px;margin-top:5px}

  .motor-section {margin-top:7px;gap:5px}
  .motor-card {padding:6px}
  .motor-speed {font-size:14px}

  .data-card {padding:7px;margin-bottom:5px}
  .data-value {font-size:15px;margin-top:4px}

  .bottom-section {margin-top:7px;gap:7px}
  .action-panel {padding:8px}
  .action-button {padding:9px 5px;font-size:8px}

  .emergency {padding:11px;margin-top:8px;font-size:12px}
  .footer {margin-top:8px;padding-top:7px}
}

@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    animation-duration:.01ms!important;
    transition-duration:.01ms!important;
  }
}

/* =====================================
   JOYSTICK FULLSCREEN MODE
===================================== */

body.joystick-fullscreen-mode {
  overflow: hidden;
}

body.joystick-fullscreen-mode .app {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  max-width: none;
  margin: 0;
  padding: 8px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

body.joystick-fullscreen-mode .header {
  display: none;
}

body.joystick-fullscreen-mode .connection-bar {
  flex-shrink: 0;
  margin: 0 0 7px;
  padding: 7px 12px;
}

body.joystick-fullscreen-mode .dashboard {
  flex: 1;
  min-height: 0;
  display: block;
  overflow: hidden;
}

body.joystick-fullscreen-mode .left-panel,
body.joystick-fullscreen-mode .right-panel {
  display: none;
}

body.joystick-fullscreen-mode .center-panel {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8px;
}

body.joystick-fullscreen-mode .center-panel > .panel-heading {
  margin-bottom: 4px;
  flex-shrink: 0;
}

body.joystick-fullscreen-mode .center-title {
  font-size: 12px;
  margin: 0;
}

body.joystick-fullscreen-mode .center-sub {
  margin: 3px 0 6px;
}

body.joystick-fullscreen-mode .joystick-grid {
  flex: 1;
  min-height: 0;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  align-items: center;
}

body.joystick-fullscreen-mode .joy-box {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 7px;
}

body.joystick-fullscreen-mode .joystick {
  width: min(43vw, 58vh, 360px);
  max-width: 360px;
  min-width: 0;
  flex-shrink: 1;
}

body.joystick-fullscreen-mode .joy-value {
  font-size: 22px;
  margin-top: 6px;
}

body.joystick-fullscreen-mode .motor-section,
body.joystick-fullscreen-mode .bottom-section,
body.joystick-fullscreen-mode .footer {
  display: none;
}

body.joystick-fullscreen-mode .emergency {
  position: fixed;
  z-index: 1000;
  left: 12px;
  bottom: max(8px, env(safe-area-inset-bottom));
  width: calc(100% - 24px);
  margin: 0;
  padding: 12px;
  font-size: 14px;
}

body.joystick-fullscreen-mode .center-panel {
  padding-bottom: 62px;
}

/* ROTATE PHONE HINT */

.joy-rotate-hint {
  display: none;
}

@media (orientation: portrait) {
  body.joystick-fullscreen-mode .joy-rotate-hint {
    display: block;
    text-align: center;
    color: #29d9ff;
    font-size: 10px;
    padding: 5px;
  }

  body.joystick-fullscreen-mode .joystick {
    width: min(38vw, 250px);
  }
}

@media (orientation: landscape) {
  body.joystick-fullscreen-mode .joystick {
    width: min(43vw, 58vh, 360px);
  }
}

</style>
</head>

<body>

<div class="background-grid"></div>
<div class="ambient"></div>

<!-- LOADER -->

<div id="loader">

  <div class="load-logo">MARINE CONTROL</div>
  <div class="load-sub">UNMANNED SURFACE VESSEL</div>

  <div class="load-circle" id="loadCircle">
    <div class="load-percent" id="loadPercent">0%</div>
  </div>

  <div class="load-bar">
    <div class="load-fill" id="loadFill"></div>
  </div>

  <div class="load-message" id="loadMessage">
    INITIALIZING SYSTEM
  </div>

</div>

<div class="app">

<!-- HEADER -->

<header class="header">

  <div class="brand">

    <div class="brand-icon">â—ˆ</div>

    <div>
      <div class="brand-name">
        MARINE <span>CONTROL</span>
      </div>

      <div class="brand-caption">
        BOAT RC / ESP32-C5
      </div>
    </div>

  </div>

<div class="header-actions">

  <button class="icon-button"
    id="joyFullButton"
    onclick="toggleJoystickFullscreen()">
    ðŸŽ® JOYSTICK FULL
  </button>

  <button class="icon-button" onclick="toggleFullscreen()">
    â›¶ FULLSCREEN
  </button>

</div>

</header>

<!-- CONNECTION -->

<div class="connection-bar">

  <div class="connection-left">

    <div class="connection-dot" id="connectionDot"></div>

    <span class="connection-label" id="connectionText">
      SYSTEM CONNECTED
    </span>

  </div>

  <div class="connection-right" id="connectionInfo">
    WIFI ACCESS POINT / C5
  </div>

</div>

<!-- MAIN DASHBOARD -->

<main class="dashboard">

  <!-- LEFT PANEL -->

  <section class="panel left-panel">

    <div class="panel-heading">
      <span>SONAR SYSTEM</span>
      <span class="panel-number">01 / RADAR</span>
    </div>

    <div class="radar-wrap">

      <div class="radar">

        <div class="radar-ring"></div>
        <div class="radar-sweep"></div>
        <div class="radar-center"></div>

        <span class="radar-label radar-n">N</span>
        <span class="radar-label radar-s">S</span>
        <span class="radar-label radar-e">E</span>
        <span class="radar-label radar-w">W</span>

      </div>

    </div>

    <div class="radar-caption">
      SCANNING <span>â— ACTIVE</span>
    </div>

    <div style="margin-top:17px">

      <div class="data-card">

        <div class="data-label">CONTROL MODE</div>

        <div class="data-value cyan" style="font-size:15px">
          DUAL DRIVE
        </div>

        <div class="data-small">
          DIFFERENTIAL MOTOR CONTROL
        </div>

      </div>

      <div class="data-card">

        <div class="data-label">SYSTEM STATE</div>

        <div class="data-value green" id="systemState"
          style="font-size:15px">
          SAFE MODE
        </div>

        <div class="data-small">
          MOTOR SAFETY STATUS
        </div>

      </div>

    </div>

  </section>

  <!-- CENTER JOYSTICK -->

  <section class="panel center-panel">

    <div class="panel-heading">
      <span>REMOTE TRANSMITTER</span>
      <span class="panel-number">02 / CONTROL</span>
    </div>

    <div class="center-title">
      DUAL JOYSTICK CONTROL
    </div>

    <div class="center-sub">
      MULTI-TOUCH / REAL-TIME CONTROL
    </div>

    <div class="joystick-grid">

      <!-- LEFT -->

      <div class="joy-box">

        <div class="joy-title green">
          LEFT STICK
        </div>

        <div class="joy-purpose">
          THROTTLE CONTROL
        </div>

        <div class="joystick disabled" id="leftPad">

          <span class="joy-axis axis-top">FWD</span>
          <span class="joy-axis axis-bottom">REV</span>

          <div class="knob" id="leftKnob"></div>

        </div>

        <div class="joy-value green" id="throttleValue">
          0%
        </div>

        <div class="joy-direction" id="throttleDirection">
          NEUTRAL
        </div>

      </div>

      <!-- RIGHT -->

      <div class="joy-box">

        <div class="joy-title cyan">
          RIGHT STICK
        </div>

        <div class="joy-purpose">
          STEERING CONTROL
        </div>

        <div class="joystick disabled" id="rightPad">

          <span class="joy-axis axis-left">LEFT</span>
          <span class="joy-axis axis-right">RIGHT</span>

          <div class="knob" id="rightKnob"></div>

        </div>

        <div class="joy-value cyan" id="steeringValue">
          0%
        </div>

        <div class="joy-direction" id="steeringDirection">
          CENTER
        </div>

      </div>

    </div>

    <!-- MOTOR DATA -->

    <div class="motor-section">

      <div class="motor-card">

        <div class="motor-card-title">
          LEFT MOTOR / M1
        </div>

        <div class="motor-speed cyan" id="leftMotor">
          0%
        </div>

        <div class="motor-track">
          <div class="motor-fill" id="leftBar"></div>
        </div>

      </div>

      <div class="motor-card">

        <div class="motor-card-title">
          RIGHT MOTOR / M2
        </div>

        <div class="motor-speed green" id="rightMotor">
          0%
        </div>

        <div class="motor-track">
          <div class="motor-fill right" id="rightBar"></div>
        </div>

      </div>

    </div>

  </section>

  <!-- RIGHT PANEL -->

  <section class="panel right-panel">

    <div class="panel-heading">
      <span>LIVE TELEMETRY</span>
      <span class="panel-number">03 / DATA</span>
    </div>

    <div class="data-card">

      <div class="data-label">
        THROTTLE
      </div>

      <div class="data-value green" id="dataThrottle">
        0%
      </div>

      <div class="data-small">
        FORWARD / REVERSE
      </div>

    </div>

    <div class="data-card">

      <div class="data-label">
        STEERING
      </div>

      <div class="data-value cyan" id="dataSteering">
        0%
      </div>

      <div class="data-small">
        LEFT / RIGHT
      </div>

    </div>

    <div class="data-card">

      <div class="data-label">
        CONTROL LINK
      </div>

      <div class="data-value green" id="dataLink"
        style="font-size:15px">
        ONLINE
      </div>

      <div class="data-small">
        ESP32 WEB SERVER
      </div>

    </div>

    <div class="data-card">

      <div class="data-label">
        DRIVE SYSTEM
      </div>

      <div class="data-value cyan" style="font-size:15px">
        2 Ã— DC MOTOR
      </div>

      <div class="data-small">
        L298N MOTOR DRIVER
      </div>

    </div>

  </section>

</main>

<!-- ACTIONS -->

<section class="bottom-section">

  <div class="action-panel">

    <div class="action-heading">
      SYSTEM CONTROL
    </div>

    <div class="action-row">

      <button class="action-button" id="armButton"
        onclick="toggleArm()">
        â–¶ ENABLE
      </button>

      <button class="action-button" onclick="resetSticks()">
        â†º CENTER
      </button>

    </div>

  </div>

  <div class="action-panel">

    <div class="action-heading">
      NAVIGATION DISPLAY
    </div>

    <div class="action-row">

      <button class="action-button active">
        â—ˆ DUAL DRIVE
      </button>

      <button class="action-button" onclick="showToast('Differential drive control')">
        âŒ– TELEMETRY
      </button>

    </div>

  </div>

</section>

<!-- EMERGENCY -->

<button class="emergency" onclick="emergencyStopNow()">
  â›” EMERGENCY STOP
</button>

<div class="footer">

  <span>MARINE CONTROL SYSTEM / V1.0</span>

  <span>ESP32-C5 / L298N</span>

</div>

</div>

<!-- TOAST -->

<div id="toast"
style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;background:#102a40;border:1px solid #29d9ff;color:#eaf7ff;padding:12px 20px;border-radius:10px;font-size:11px;z-index:99999;transition:.25s">
</div>

<script>

// ========================================
// LOADING ANIMATION
// ========================================

let load = 0;

const loadMessages = [
  "INITIALIZING SYSTEM",
  "LOADING CONTROL MODULE",
  "CONNECTING INTERFACE",
  "PREPARING JOYSTICKS",
  "SYSTEM READY"
];

const loadingTimer = setInterval(() => {

  load += 1;

  if(load > 100) load = 100;

  document.getElementById("loadPercent").innerText =
    load + "%";

  document.getElementById("loadFill").style.width =
    load + "%";

  document.getElementById("loadCircle").style.background =
    `conic-gradient(#29d9ff ${load}%,#15253a ${load}%)`;

  let index = Math.min(4,Math.floor(load / 21));

  document.getElementById("loadMessage").innerText =
    loadMessages[index];

  if(load >= 100) {

    clearInterval(loadingTimer);

    setTimeout(() => {
      document.getElementById("loader").classList.add("hide");
    },300);

  }

},15);

// ========================================
// STATE
// ========================================

let throttle = 0;
let steering = 0;

let armed = false;
let connected = false;

let controlBusy = false;
let lastStatusTime = 0;

// ========================================
// DOM
// ========================================

const leftPad = document.getElementById("leftPad");
const rightPad = document.getElementById("rightPad");

const leftKnob = document.getElementById("leftKnob");
const rightKnob = document.getElementById("rightKnob");

// ========================================
// TOAST
// ========================================

let toastTimer;

function showToast(message) {

  const toast = document.getElementById("toast");

  toast.innerText = message;

  toast.style.opacity = "1";
  toast.style.transform =
    "translateX(-50%) translateY(0)";

  clearTimeout(toastTimer);

  toastTimer = setTimeout(() => {

    toast.style.opacity = "0";

    toast.style.transform =
      "translateX(-50%) translateY(20px)";

  },2000);

}

// ========================================
// CONNECTION DISPLAY
// ========================================

function setConnection(state) {

  connected = state;

  const dot = document.getElementById("connectionDot");
  const label = document.getElementById("connectionText");

  const data = document.getElementById("dataLink");

  if(state) {

    dot.classList.remove("offline");
    label.classList.remove("offline");

    label.innerText = "SYSTEM CONNECTED";
    data.innerText = "ONLINE";
    data.className = "data-value green";

  } else {

    dot.classList.add("offline");
    label.classList.add("offline");

    label.innerText = "CONNECTION LOST";
    data.innerText = "OFFLINE";
    data.className = "data-value";
    data.style.color = "#ff405c";

  }

}

// ========================================
// ARM DISPLAY
// ========================================

function updateArmDisplay() {

  const button = document.getElementById("armButton");

  document.getElementById("systemState").innerText =
    armed ? "ACTIVE" : "SAFE MODE";

  document.getElementById("systemState").style.color =
    armed ? "#42f5a1" : "#718aa6";

  if(armed) {

    button.innerText = "â–  DISABLE";
    button.classList.add("active");

    leftPad.classList.remove("disabled");
    rightPad.classList.remove("disabled");

  } else {

    button.innerText = "â–¶ ENABLE";
    button.classList.remove("active");

    leftPad.classList.add("disabled");
    rightPad.classList.add("disabled");

  }

}

// ========================================
// MOTOR MIXING
// ========================================

function calculateMotors() {

  let left = throttle + steering;
  let right = throttle - steering;

  const peak = Math.max(
    Math.abs(left),
    Math.abs(right)
  );

  if(peak > 100) {

    left = left * 100 / peak;
    right = right * 100 / peak;

  }

  return {
    left:Math.round(left),
    right:Math.round(right)
  };

}

// ========================================
// DISPLAY
// ========================================

function updateDisplay() {

  document.getElementById("throttleValue").innerText =
    Math.abs(throttle) + "%";

  document.getElementById("steeringValue").innerText =
    Math.abs(steering) + "%";

  document.getElementById("dataThrottle").innerText =
    throttle + "%";

  document.getElementById("dataSteering").innerText =
    steering + "%";

  document.getElementById("throttleDirection").innerText =
    throttle > 0 ? "FORWARD" :
    throttle < 0 ? "REVERSE" : "NEUTRAL";

  document.getElementById("steeringDirection").innerText =
    steering > 0 ? "TURN RIGHT" :
    steering < 0 ? "TURN LEFT" : "CENTER";

  const motors = calculateMotors();

  const left = motors.left;
  const right = motors.right;

  document.getElementById("leftMotor").innerText =
    left + "%";

  document.getElementById("rightMotor").innerText =
    right + "%";

  document.getElementById("leftBar").style.width =
    Math.abs(left) + "%";

  document.getElementById("rightBar").style.width =
    Math.abs(right) + "%";

}

// ========================================
// RESET JOYSTICKS
// ========================================

function resetSticks() {

  throttle = 0;
  steering = 0;

  leftKnob.style.setProperty("--x","0px");
  leftKnob.style.setProperty("--y","0px");

  rightKnob.style.setProperty("--x","0px");
  rightKnob.style.setProperty("--y","0px");

  updateDisplay();

}

// ========================================
// JOYSTICK ENGINE
// ========================================

function setupJoystick(pad,knob,axis) {

  let pointerId = null;

  function move(event) {

    if(!armed) return;

    const rect = pad.getBoundingClientRect();

    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;

    const maxX = rect.width * .31;
    const maxY = rect.height * .31;

    let dx = event.clientX - cx;
    let dy = event.clientY - cy;

    if(axis === "vertical") {

      dy = Math.max(-maxY,Math.min(maxY,dy));

      dx = 0;

      throttle = Math.round(-dy / maxY * 100);

    } else {

      dx = Math.max(-maxX,Math.min(maxX,dx));

      dy = 0;

      steering = Math.round(dx / maxX * 100);

    }

    knob.style.setProperty("--x",dx + "px");
    knob.style.setProperty("--y",dy + "px");

    updateDisplay();

  }

  function release(event) {

    if(pointerId === null) return;

    if(event && event.pointerId !== undefined &&
       event.pointerId !== pointerId) return;

    pointerId = null;

    if(axis === "vertical") {
      throttle = 0;
    } else {
      steering = 0;
    }

    knob.style.setProperty("--x","0px");
    knob.style.setProperty("--y","0px");

    updateDisplay();

  }

  pad.addEventListener("pointerdown",event => {

    if(!armed || pointerId !== null) return;

    event.preventDefault();

    pointerId = event.pointerId;

    pad.setPointerCapture(pointerId);

    move(event);

  });

  pad.addEventListener("pointermove",event => {

    if(pointerId !== event.pointerId) return;

    event.preventDefault();

    move(event);

  });

  pad.addEventListener("pointerup",release);

  pad.addEventListener("pointercancel",release);

  pad.addEventListener("lostpointercapture",release);

}

setupJoystick(leftPad,leftKnob,"vertical");

setupJoystick(rightPad,rightKnob,"horizontal");

// ========================================
// SEND MOTOR CONTROL
// ========================================

async function sendControl() {

  if(!armed || controlBusy) return;

  controlBusy = true;

  try {

    const response = await fetch(
      "/control?t=" + throttle + "&s=" + steering,
      {cache:"no-store"}
    );

    if(!response.ok) {
      throw new Error("Control rejected");
    }

    setConnection(true);

  } catch(error) {

    setConnection(false);

    armed = false;

    resetSticks();

    updateArmDisplay();

    showToast("CONNECTION LOST - FAILSAFE");

  } finally {

    controlBusy = false;

  }

}

// ========================================
// ENABLE / DISABLE
// ========================================

async function toggleArm() {

  if(armed) {

    await emergencyStopNow();

    return;

  }

  try {

    const response = await fetch("/control?arm=1");

    if(!response.ok) throw new Error("ARM FAILED");

    armed = true;

    resetSticks();

    updateArmDisplay();

    showToast("CONTROL SYSTEM ENABLED");

    setConnection(true);

  } catch(error) {

    setConnection(false);

    showToast("UNABLE TO ENABLE SYSTEM");

  }

}

// ========================================
// EMERGENCY STOP
// ========================================

async function emergencyStopNow() {

  armed = false;

  resetSticks();

  updateArmDisplay();

  try {

    const response = await fetch("/control?stop=1");

    if(!response.ok) throw new Error("STOP FAILED");

    showToast("EMERGENCY STOP ACTIVATED");

  } catch(error) {

    showToast("CONNECTION LOST - CHECK FAILSAFE");

  }

}

// ========================================
// HEARTBEAT
// ========================================

setInterval(() => {

  if(armed) {
    sendControl();
  }

},120);

// ========================================
// STATUS MONITOR
// ========================================

async function checkStatus() {

  try {

    const response = await fetch(
      "/status",
      {cache:"no-store"}
    );

    if(!response.ok) throw new Error("STATUS ERROR");

    const data = await response.json();

    setConnection(true);

    lastStatusTime = Date.now();

    if(!data.armed && armed) {

      armed = false;

      resetSticks();

      updateArmDisplay();

      showToast("SYSTEM STOPPED / FAILSAFE");

    }

  } catch(error) {

    setConnection(false);

    if(armed) {

      armed = false;

      resetSticks();

      updateArmDisplay();

      showToast("CONNECTION LOST");

    }

  }

}

setInterval(checkStatus,700);

// ========================================
// FULLSCREEN
// ========================================

async function toggleFullscreen() {

  try {

    if(!document.fullscreenElement) {

      await document.documentElement.requestFullscreen();

      if(screen.orientation && screen.orientation.lock) {

        try {
          await screen.orientation.lock("landscape");
        } catch(error) {
          console.log("Orientation lock unsupported");
        }

      }

    } else {

      await document.exitFullscreen();

    }

  } catch(error) {

    showToast("FULLSCREEN NOT SUPPORTED");

  }

}

document.addEventListener("fullscreenchange",() => {

  document.body.classList.toggle(
    "fullscreen-mode",
    !!document.fullscreenElement
  );

});

// ========================================
// PAGE VISIBILITY SAFETY
// ========================================

document.addEventListener("visibilitychange",() => {

  if(document.hidden && armed) {

    emergencyStopNow();

  }

});

/* =====================================
   JOYSTICK FULLSCREEN FUNCTION
===================================== */

async function toggleJoystickFullscreen() {

  const active = document.body.classList.contains(
    "joystick-fullscreen-mode"
  );

  const button = document.getElementById("joyFullButton");

  if (active) {

    document.body.classList.remove(
      "joystick-fullscreen-mode"
    );

    button.innerText = "ðŸŽ® JOYSTICK FULL";

    if (document.fullscreenElement) {
      try {
        await document.exitFullscreen();
      } catch (error) {
        console.log(error);
      }
    }

    showToast("JOYSTICK MODE CLOSED");

    return;
  }

  document.body.classList.add(
    "joystick-fullscreen-mode"
  );

  button.innerText = "âœ• EXIT JOYSTICK";

  try {

    if (!document.fullscreenElement &&
        document.documentElement.requestFullscreen) {

      await document.documentElement.requestFullscreen();

    }

    if (screen.orientation &&
        screen.orientation.lock) {

      try {
        await screen.orientation.lock("landscape");
      } catch (error) {
        console.log("Rotate phone manually");
      }

    }

  } catch (error) {

    // à¸¢à¸±à¸‡à¸„à¸‡à¹ƒà¸Šà¹‰à¹‚à¸«à¸¡à¸”à¸ˆà¸­à¸¢à¹€à¸•à¹‡à¸¡à¸«à¸™à¹‰à¸²à¸ˆà¸­à¹à¸šà¸š CSS à¹„à¸”à¹‰
    console.log("Browser fullscreen unavailable");

  }

}

// à¸­à¸­à¸à¸ˆà¸²à¸à¹‚à¸«à¸¡à¸”à¹€à¸¡à¸·à¹ˆà¸­à¸œà¸¹à¹‰à¹ƒà¸Šà¹‰à¸à¸” ESC
// à¸«à¸£à¸·à¸­à¸­à¸­à¸à¸ˆà¸²à¸ Fullscreen à¸œà¹ˆà¸²à¸™à¹€à¸šà¸£à¸²à¸§à¹Œà¹€à¸‹à¸­à¸£à¹Œ

document.addEventListener("fullscreenchange", () => {

  if (!document.fullscreenElement &&
      document.body.classList.contains(
        "joystick-fullscreen-mode"
      )) {

    document.body.classList.remove(
      "joystick-fullscreen-mode"
    );

    document.getElementById("joyFullButton").innerText =
      "ðŸŽ® JOYSTICK FULL";

  }

});

// ========================================
// INITIALIZE
// ========================================

resetSticks();

updateArmDisplay();

checkStatus();

</script>

</body>
</html>
