<!DOCTYPE html>
<html>
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1">

<title>Boat Motor Controller</title>

<style>

body {
  font-family: Arial, sans-serif;
  background: #101827;
  color: white;
  text-align: center;
  margin: 0;
  padding: 20px;
}

h1 {
  color: #38bdf8;
}

.container {
  max-width: 500px;
  margin: auto;
}

.card {
  background: #1e293b;
  padding: 20px;
  margin: 15px 0;
  border-radius: 15px;
}

input[type=range] {
  width: 100%;
  margin: 20px 0;
}

.speed {
  font-size: 30px;
  color: #38bdf8;
  font-weight: bold;
}

button {
  padding: 13px 20px;
  margin: 5px;
  border: none;
  border-radius: 8px;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.forward {
  background: #16a34a;
}

.reverse {
  background: #2563eb;
}

.stop {
  background: #dc2626;
}

.stopAll {
  background: #991b1b;
  width: 100%;
  font-size: 18px;
  margin-top: 20px;
}

</style>

</head>

<body>

<div class="container">

<h1>BOAT MOTOR CONTROLLER</h1>

<p>ESP32 + L298N</p>

<!-- MOTOR 1 -->

<div class="card">

<h2>MOTOR 1</h2>

<div class="speed" id="m1Value">0%</div>

<input type="range"
id="m1"
min="0"
max="100"
value="0"
oninput="updateSpeed(1,this.value)">

<br>

<button class="forward"
onclick="setDirection(1,'F')">
FORWARD
</button>

<button class="reverse"
onclick="setDirection(1,'R')">
REVERSE
</button>

</div>

<!-- MOTOR 2 -->

<div class="card">

<h2>MOTOR 2</h2>

<div class="speed" id="m2Value">0%</div>

<input type="range"
id="m2"
min="0"
max="100"
value="0"
oninput="updateSpeed(2,this.value)">

<br>

<button class="forward"
onclick="setDirection(2,'F')">
FORWARD
</button>

<button class="reverse"
onclick="setDirection(2,'R')">
REVERSE
</button>

</div>

<button class="stopAll"
onclick="stopAll()">
STOP ALL
</button>

</div>

<input type="hidden" id="d1" value="F">
<input type="hidden" id="d2" value="F">

<script>

function sendControl() {

  let m1 = document.getElementById("m1").value;
  let m2 = document.getElementById("m2").value;

  let d1 = document.getElementById("d1").value;
  let d2 = document.getElementById("d2").value;

  fetch(
    "/control?m1=" + m1 +
    "&m2=" + m2 +
    "&d1=" + d1 +
    "&d2=" + d2
  ).catch(error => console.log(error));

}

function updateSpeed(motor, value) {

  document.getElementById(
    "m" + motor + "Value"
  ).innerText = value + "%";

  sendControl();

}

function setDirection(motor, direction) {

  document.getElementById(
    "d" + motor
  ).value = direction;

  sendControl();

}

function stopAll() {

  document.getElementById("m1").value = 0;
  document.getElementById("m2").value = 0;

  document.getElementById("m1Value").innerText = "0%";
  document.getElementById("m2Value").innerText = "0%";

  fetch("/control?stop=1");

}

</script>

</body>
</html>

